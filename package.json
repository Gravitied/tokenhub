{
  "name": "tokenhub-mcp",
  "version": "0.1.0",
  "description": "A token-disciplined developer MCP hub with a tiny always-loaded surface and deferred internal capabilities.",
  "type": "module",
  "author": "Gravitied",
  "bin": {
    "tokenhub-mcp": "dist/cli.js"
  },
  "homepage": "https://github.com/Gravitied/tokenhub#readme",
  "bugs": {
    "url": "https://github.com/Gravitied/tokenhub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gravitied/tokenhub.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','dist-bench']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:runtime && npm run build:bench",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:bench": "tsc -p tsconfig.bench.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "bench": "npm run build && node scripts/run-benchmarks.mjs",
    "eval:resolve-request": "npm run build && node scripts/evaluate-resolve-request.mjs",
    "eval:resolve-request:live": "npm run build && node scripts/evaluate-live-resolve-request.mjs",
    "proof": "node scripts/generate-proof-page.mjs",
    "prepack": "npm run build",
    "smoke:install": "node scripts/smoke-install.mjs",
    "verify:release": "npm run lint && npm test && npm run build && npm run eval:resolve-request && npm run eval:resolve-request:live && npm pack --dry-run && npm run smoke:install"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "token-efficiency",
    "playwright",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.20.0",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.20.0",
    "@types/sql.js": "^1.4.11",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
