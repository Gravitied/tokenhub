{
  "name": "tokenhub-mcp",
  "version": "0.1.0",
  "description": "A token-disciplined developer MCP hub with a tiny always-loaded surface and deferred internal capabilities.",
  "type": "module",
  "bin": {
    "tokenhub-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "bench": "npm run build && node scripts/run-benchmarks.mjs",
    "eval:resolve-request": "npm run build && node scripts/evaluate-resolve-request.mjs",
    "eval:resolve-request:live": "npm run build && node scripts/evaluate-live-resolve-request.mjs",
    "proof": "node scripts/generate-proof-page.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "token-efficiency",
    "playwright",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.20.0",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.20.0",
    "@types/sql.js": "^1.4.11",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
